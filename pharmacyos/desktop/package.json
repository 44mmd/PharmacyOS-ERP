{
  "name": "pharmacyos-erp-desktop",
  "productName": "PharmacyOS ERP",
  "version": "0.1.0",
  "description": "PharmacyOS ERP — Pharmacy Operating System. Designed & Developed by HALF.",
  "author": "HALF",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.half.pharmacyos.erp",
    "productName": "PharmacyOS ERP",
    "copyright": "© 2026 HALF",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [{ "from": "../LICENSE-NOTICES.txt", "to": "LICENSE-NOTICES.txt" }],
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "PharmacyOS-ERP-Setup-${version}.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PharmacyOS ERP",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
