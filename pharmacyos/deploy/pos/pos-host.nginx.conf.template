# PharmacyOS POS host — e.g. pos.halfpharmacy.com — an nginx server block of its own.
#
# Serves the ERP site's POS screen under a dedicated hostname. It is ADDITIVE: it does not change the
# bench's own nginx configuration, the storefront (halfpharmacy.com) or the admin panel
# (admin.halfpharmacy.com), which are separate systems. Remove the file to remove the POS host.
#
# Rendered by setup-pos-host.sh (placeholders in double underscores): the POS hostname, the Frappe site
# of the pharmacy, the bench sites directory, the gunicorn address, the listen directive ("443 ssl" in
# production; a plain port only on a closed test network) and the certificate lines.
#
# Security notes:
# * Nobody can use the POS without signing in: /pos redirects guests to Frappe's /login, and every
#   API call is checked by Frappe against the signed-in user's own roles. This file adds no access.
# * The session is Frappe's HTTP-only `sid` cookie, host-only (it never travels to halfpharmacy.com or
#   admin.halfpharmacy.com), SameSite=Lax; unsafe requests need Frappe's CSRF token.
# * No CORS headers are sent: the POS calls its own origin only.

upstream __UPSTREAM_NAME__ {
	server __UPSTREAM__ fail_timeout=0;
}

server {
	listen __LISTEN__;
	server_name __POS_HOST__;
	root __SITES__;
__TLS__
	client_max_body_size 10m;
	proxy_buffer_size 128k;
	proxy_buffers 4 256k;
	proxy_busy_buffers_size 256k;

	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header Referrer-Policy "same-origin" always;
	add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
	# (a location that sets its own add_header drops these: /pos and /assets repeat what they need)

	# the POS hostname opens the POS
	location = / {
		return 302 /pos;
	}

	# the POS screen: only its own origin, no plug-ins, no framing by other sites
	location = /pos {
		add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
		add_header X-Frame-Options "SAMEORIGIN" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Referrer-Policy "same-origin" always;
		add_header Cache-Control "no-store" always;
		add_header Strict-Transport-Security "max-age=31536000" always;  # ignored by browsers over plain HTTP
		# proxied here (not via @frappe) so these headers apply to the response
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Frappe-Site-Name __SITE__;
		proxy_set_header Host $host;
		proxy_read_timeout 120;
		proxy_redirect off;
		proxy_pass http://__UPSTREAM_NAME__;
	}

	location /assets {
		try_files $uri =404;
		add_header Cache-Control "max-age=31536000";
		add_header Strict-Transport-Security "max-age=31536000" always;
	}

	location ~ ^/protected/(.*) {
		internal;
		try_files /__SITE__/$1 =404;
	}

	location / {
		rewrite ^(.+)/$ $1 permanent;
		location ~* ^/files/.*.(htm|html|svg|xml) {
			add_header Content-disposition "attachment";
			try_files /__SITE__/public/$uri @frappe;
		}
		try_files /__SITE__/public/$uri @frappe;
	}

	location @frappe {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Frappe-Site-Name __SITE__;
		proxy_set_header Host $host;
		proxy_set_header X-Use-X-Accel-Redirect True;
		proxy_read_timeout 120;
		proxy_redirect off;
		proxy_pass http://__UPSTREAM_NAME__;
	}
}
